{
  "name": "foundation/internal-management-system",
  "description": "Internal foundation management system built with PHP and MySQL.",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/Support/helpers.php"
    ]
  },
  "require-dev": {
    "phpunit/phpunit": "^11"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
