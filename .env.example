APP_NAME="游榮吉教育基金會管理系統"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Taipei
APP_VERSION=0.6.94

GITHUB_REPO=
GITHUB_TOKEN=
