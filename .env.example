APP_NAME="游榮吉教育基金會管理系統"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Taipei
APP_VERSION=0.7.12

GITHUB_REPO=
GITHUB_TOKEN=
UPDATE_CHANNEL=stable

# 緊急停用「僅限台灣 IP」連線管制。若因誤設被鎖在門外,設為 true 即強制放行所有連線。
ACCESS_CONTROL_DISABLED=false

# 自動封鎖累犯 IP(fail2ban 式):同一來源 IP 於觀察視窗內登入失敗達門檻即暫時封鎖。
# 緊急停用設為 true(自動封鎖與現有名單皆不生效);其餘為門檻／視窗/封鎖時間(分鐘)。
IP_AUTOBLOCK_DISABLED=false
IP_AUTOBLOCK_FAIL_THRESHOLD=20
IP_AUTOBLOCK_WINDOW_MINUTES=15
IP_AUTOBLOCK_MINUTES=60

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=foundation_system
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=foundation_session
SESSION_LIFETIME_MINUTES=60
REMEMBER_COOKIE=foundation_remember
REMEMBER_LIFETIME_DAYS=30

MAIL_ENABLED=false
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="基金會管理系統"
